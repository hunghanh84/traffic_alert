@startuml Sequence Diagram - Tìm kiếm
title sd_TimKiem

actor "Người dùng" as a
participant "V_TimKiem" as b
participant "C_AlertController" as c
participant "M_BaiDang" as d

a -> b : 1: load()
activate b
b --> a : 2: hienThiForm()
deactivate b

a -> b : 3: nhapTieuChi()
a -> b : 4: clickTimKiem()
activate b
b -> c : 5: search(tieuChi)
activate c
c -> d : 6: select(where)
activate d
d --> c : 7: ketQua
deactivate d
c --> b : 8: duLieu
deactivate c
b --> a : 9: hienThiKetQua()
deactivate b

@enduml
